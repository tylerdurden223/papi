messageLabel.TextXAlignment = Enum.TextXAlignment.Center

local subLabel = Instance.new("TextLabel")
subLabel.Parent = frame
subLabel.Size = UDim2.new(1, -40, 0, 20)
subLabel.Position = UDim2.new(0, 20, 1, -40)
subLabel.BackgroundTransparency = 1
subLabel.Text = "We're improving the script with new features and fixes"
subLabel.TextColor3 = Color3.fromRGB(160, 160, 165)
subLabel.TextSize = 14
subLabel.Font = Enum.Font.Gotham
subLabel.TextYAlignment = Enum.TextYAlignment.Center
subLabel.TextXAlignment = Enum.TextXAlignment.Center

local dragging = false
local dragStart = Vector2.new()
local startPos = UDim2.new()

local function isOverClose(pos)
	if not closeButton then return false end
	local a = closeButton.AbsolutePosition
	local s = closeButton.AbsoluteSize
	return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if isOverClose(input.Position) then return end
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)
